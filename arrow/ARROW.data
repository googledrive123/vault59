EaseLJS, pertenece a Createjs.com
window.kongregate_js =
{
    init: function( f1 )
    {
        var callbackForPreferences = LuaCreateFunction( f1 );
        
        var head    = document.getElementsByTagName('head')[0];
        var script  = document.createElement('script');
        script.type = 'text/javascript';
        script.src  = 'https://cdn1.kongregate.com/javascripts/kongregate_api.js';

        // Callback compatibility function
        var onReadyFunction = function() {
            kongregateAPI.loadAPI(function() {
                window.kongregate = kongregateAPI.getAPI();
                var strPreferences = window.kongregate_js.getData( "preferences" ) || 1;
                
                if ( strPreferences == 1 ) { // Es la primera vez HTML5
                    
                    var stringObjPreferences = callbackForPreferences( 1 );
                    
                    window.kongregate_js.saveData( "preferences", stringObjPreferences );
                    window.kongregate_js.saveData( "1-unlock", 0 );
                    window.kongregate_js.saveData( "2-unlock", 0 );
                    window.kongregate_js.saveData( "3-unlock", 0 );
                    
                    // execute 'loadingScene1' function on lua
                    callbackForPreferences( 2 );
                    
                    LuaReleaseFunction( callbackForPreferences );
                    
                } else { // is more than once HTML5
                    
                    console.log( strPreferences );
                    
                    callbackForPreferences( strPreferences );
                    
                    // execute 'loadingScene1' function on lua
                    callbackForPreferences( 2 );
                    
                    LuaReleaseFunction( callbackForPreferences );
                }
                
                // resubmit the stat
                var result = window.kongregate_js.getData( "statistic" ); // string clave/valor(label, content) separado por '|'
                
                if ( typeof result === "string" ) { // there is a value
                    
                    window.kongregate_js.submitStat( result.split('|')[0], result.split('|')[1] );
                    
                    window.kongregate_js.removeItem( "statistic" );
                }
            });
        };
        
        script.onreadystatechange = onReadyFunction;
        script.onload = onReadyFunction;
        
        head.appendChild(script);
        
    },

    submitStat: function( label, value )
    {
        // You need to submit all data to us twice: first, when the specific event actually occurs, and then again when the game is reloaded.
        console.log('Kongregate submitStat(' + label + ',' + value + ')');
        kongregate.stats.submit( label, value );
        
        // salva en el cliente para subir de nuevo al cargar el juego
        window.kongregate_js.saveData( "statistic", label + "|" + value );
    },
    
    saveData: function( type, content )
    {
        // para salvar el progreso de un puzzle, y salvar el ultimo level desbloqueado una vez que se supere un level
        // guardar ultimo level desbloqueado de un paquete: 'type': package.."-unlock"
        // guardar progreso de un puzzle 'type': package.."-level-"..level
        console.log("guardando dato: " + window.kongregate_js.getUserID() + type );
        
        if (typeof Storage !== "undefined") {
            localStorage.setItem( window.kongregate_js.getUserID() + type, content );
        }
    },
    
    getData: function( type )
    {
        var result;
        // type - string - puede ser algo como '1-unlock'
        // para ver si hay un progreso guardado para el puzzle actual llamo a esta funcion enviando como parametro de 'type': package.."-level-"..level, y si devuelve un 0 es que no tiene guardado nada
        
        if (typeof Storage !== "undefined") {
            result = localStorage.getItem( window.kongregate_js.getUserID() + type );
            
            if ( result === null && type.indexOf("-unlock") !== -1 ) {
                // aÃ±adir nuevamente el primer caracter de 'type' a 'type' porque en la versiÃ³n anterior estaba guardando este tipo de dato con el primer valor (que es el no. paquete) repetido
                
                var primeraLetra = type.substr(0,1);
                result = localStorage.getItem( window.kongregate_js.getUserID() + primeraLetra + type );
            }
        }
        return result;
    },
    
    removeItem: function( type ){
        if (typeof Storage !== "undefined") {
            localStorage.removeItem( window.kongregate_js.getUserID() + type );
        }
    },
    
    getUsername: function()
    {
        console.log('Kongregate getUsername()');
        return kongregate.services.getUsername();
    },
    
    getUserID: function()
    {
        console.log('Kongregate getUserID() = ' + kongregate.services.getUserId() );
        // return 0 if the user is not signed in
        return kongregate.services.getUserId();
    },
    
    isGuest: function()
    {
        console.log('Kongregate isGuest()');
        return kongregate.services.isGuest();
    },
    
};

console.log('kongregate_js is loaded');
