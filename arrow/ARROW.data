settings =
{
  splashScreen =
	{
    enable = false,
  },
  
	orientation =
	{
      -- Supported values for orientation:
      -- portrait, portraitUpsideDown, landscapeLeft, landscapeRight
      default = "landscapeLeft",
      supported = { "landscapeLeft", "landscapeRight" },
	},

	win32 =
  {
      -- Settings for Win32 apps go here
      
      preferenceStorage = "sqlite",
      singleInstance = true,
  },
  
  window =
  {
      -- Settings for the desktop window; applies to both Win32 and macOS desktop apps
      defaultMode = "normal", -- instead of 'fullscreen'
      
      defaultViewWidth = 800, -- 922
      defaultViewHeight = 487,
      
      resizable = false,
      
      enableCloseButton = false, -- como Corona no tiene un evento cuando se activa este boton entonces lo desactivo para crearlo programaticamente. If disabled, you must close the window in Lua via native.requestExit().
      
      suspendWhenMinimized = true,
      
      -- for coolmathgames: "ARROW - Play it now at CoolmathGames.com"
      -- Para el resto: "ARROW"
      
      titleText = {
          -- The "default" text will be used if the system is using a language and/or
          -- country code not defined below. This serves as a fallback mechanism.
          default = "ARROW - Play it now at CoolmathGames.com",
      },
      
  }, -- end of 'window' settings
  
  
	-- Plugins section
  
	plugins =
	{
      
  },

	--
	-- Project section
	--
	excludeFiles =
	{
		-- Exclude unnecessary files for each platform
		all = { "Icon.png", "Icon*.ico", "Icon*.icns", "no_incluir", "assets/database/levels.db", "Thumbs.db" },
		-- web = {}, -- this for HTML5 builds
	},
}

window.coolmathgames_js =
{
    init: function( f1 )
    {
        var callbackForPreferences = LuaCreateFunction( f1 );
        
        // set the page title of your index.html to 'Links Puzzle - Play it now at CoolmathGames.com'
        
        // get the device screen width
        // var width = (window.innerWidth > 0) ? window.innerWidth : screen.width;
        
        var execAfter = function(){
            
            var strPreferences = window.coolmathgames_js.getData( "preferences" ) || 1;
            
            if ( strPreferences == 1 ) { // primera vez HTML5
                
                var stringObjPreferences = callbackForPreferences( 1 );
                
                console.log(" Is first time: preferences = " + stringObjPreferences );
                
                window.coolmathgames_js.saveData( "preferences", stringObjPreferences );
                window.coolmathgames_js.saveData( "1-unlock", 1 );
                window.coolmathgames_js.saveData( "2-unlock", 1 );
                window.coolmathgames_js.saveData( "3-unlock", 1 );
                
                // execute 'loadingScene1' function on lua
                callbackForPreferences( 2 );
                
                LuaReleaseFunction( callbackForPreferences );
                
            } else { // is more than once HTML5
                
                console.log(" Is more than once time: preferences = " + strPreferences );
                
                // Get the 'lastGame' value for each pack.
                var v1 = window.coolmathgames_js.getData( "1-unlock" );
                var v2 = window.coolmathgames_js.getData( "2-unlock" );
                var v3 = window.coolmathgames_js.getData( "3-unlock" );
                
                console.log( "lastGame1 = "+ v1 );
                console.log( "lastGame2 = "+ v2 );
                console.log( "lastGame3 = "+ v3 );
                
                // execute 'loadingScene1' function on lua
                callbackForPreferences( strPreferences, v1, v2, v3 );
                
                LuaReleaseFunction( callbackForPreferences );
            }
            
            window.addEventListener("keydown", function(e) {
                // arrow keys: 37, 38, 39, 40 Arrow keys, space bar: 32
                // keyCode is deprecated
                if ( [37, 38, 39, 40].indexOf(e.key) > -1 || [37, 38, 39, 40].indexOf(e.keyCode) > -1 ) {
                    e.preventDefault();
                }
            }, false);
            
        };
        
        execAfter();
        
        /*
        var domainList = [ 'https://www.coolmathgames.com', 'www.coolmathgames.com', 'edit.coolmathgames.com', 'www.stage.coolmathgames.com', 'edit-stage.coolmathgames.com', 'dev.coolmathgames.com', 'm.coolmathgames.com', 'https://www.coolmath-games.com', 'www.coolmath-games.com', 'edit.coolmath-games.com', 'edit-stage.coolmath-games.com', 'dev.coolmath-games.com', 'm.coolmath-games.com' ];
        
        var myLocation = parent.location.href;
        var c = domainList.length;
        var i = 0;
        var isFounded = false;
        
        while ( i < c && !isFounded ){
            if ( myLocation.indexOf( domainList[i] ) !== -1 ) {
                // el juego estÃ¡ alojado en un dominio permitido
                isFounded = true;
            } else {
                if ( i === c - 1 ) {
                    // estÃ¡ alojado en un dominio no permitido, redirigo a otra pÃ¡gina
                    window.location.assign( "http://www.google.com" );
                }
            }
            i = i + 1;
        }
        */
    },
    
    gameEvent: function( strEvent, v ){
        console.log("Game event: " + strEvent );
        // play button:       event = "start"
        // start a new level: event = "start"
        // replay:            event = "replay"
        if ( typeof parent.cmgGameEvent === "function" ) {
            if ( typeof v === "undefined" ) {
                parent.cmgGameEvent( strEvent );
            } else {
                parent.cmgGameEvent( strEvent, v );
            }
        }
    },
    
    submitStat: function( label, value ) { },
    
    saveData: function( type, content )
    {
        // guardar ultimo level desbloqueado de un paquete: 'type': package.."-unlock"
        // guardar progreso de un puzzle 'type': package.."-level-"..level
        console.log("save data: " + window.coolmathgames_js.getUserID() + type + "content = " + content);
        
        if (typeof Storage !== "undefined") {
            localStorage.setItem( window.coolmathgames_js.getUserID() + type, content );
        }
    },
    
    getData: function( type )
    {
        console.log("GET DATA " + type);
        var result;
        if (typeof Storage !== "undefined") {
            result = localStorage.getItem( window.coolmathgames_js.getUserID() + type );
            console.log( "result = " + result );
            return result;
        }
    },
    
    removeItem: function( type ){
        if (typeof Storage !== "undefined") {
            localStorage.removeItem( window.coolmathgames_js.getUserID() + type );
        }
    },
    
    getUserID: function()
    {
        return 'coolmathg-AlecGames-Arrow-v3-'; // '' --> prefijo definitivo
    },
    
    getDevice: function(){
        var deviceType = "desktop";
        // device detection
        const ua = navigator.userAgent;
        if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) {
            return "tablet";
        }
        else if (/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry|Kindle|Silk-Accelerated|(hpw|web)OS|Opera M(obi|ini)/.test(ua))  {
            return "mobile";
        }
        return "desktop";
        
    }
    
};

console.log('coolmathgames_js is loaded');


/*

For maintainability, I would attach the "blocking" handler on the element itself (in your case, the canvas).

document.getElementsByTagName("CANVAS").onkeydown = function (e) {
    if (e.key === 'ArrowUp' || e.key === 'ArrowDown' ) {
        e.view.event.preventDefault();
    }
}

window.addEventListener("keydown", function(e) {
    // space and arrow keys, 37, 38, 39, 40 Arrow keys
    // keyCode is deprecated
    if ( [32, 37, 38, 39, 40].indexOf(e.key) > -1 || [32, 37, 38, 39, 40].indexOf(e.keyCode) > -1 ) {
        e.preventDefault();
    }
}, false);

*/


window.crazygames_js =
{
    requestAd: function(){},
    
    adReward: 0, // '0' for 'hints', '1' for 'undos'.
    
    adType: "midgame", // 'midgame' or 'rewarded'
    
    rewardHints: function( f ){
        if ( LuaIsFunction( f ) ) {
            window.crazygames_js.rewardHintsFunction = LuaCreateFunction( f );
        } else {
            window.crazygames_js.rewardHintsFunction();
        }
    },
    rewardUndos: function( f ){
        if ( LuaIsFunction( f ) ) {
            window.crazygames_js.rewardUndosFunction = LuaCreateFunction( f );
        } else {
            window.crazygames_js.rewardUndosFunction();
        }
    },
    
    adError: function( f ){
        if ( LuaIsFunction( f ) ) {
            window.crazygames_js.adErrorFunction = LuaCreateFunction( f );
        } else {
            window.crazygames_js.adErrorFunction();
        }
    },
    
    init: function( f1 )
    {
        var callbackForPreferences = LuaCreateFunction( f1 );
        
        var head    = document.getElementsByTagName('head')[0];
        var script  = document.createElement('script');
        script.type = 'text/javascript';
        script.src  = 'https://sdk.crazygames.com/crazygames-sdk-v1.js';
        
        // Callback compatibility function
        var onReadyFunction = function() {
            
            //var domainList = [ '*.crazygames.*', '*.1001juegos.com', '*.onlinegame.co.id', '*.speelspelletjes.nl' ];
            var domainList = [ '.crazygames.', '.1001juegos.com', '.onlinegame.co.id', '.speelspelletjes.nl' ];
            
            var myLocation = window.location.href;
            
            var c = domainList.length;
            var i = 0;
            var isFounded = false;
            //var regexpresion;
            
            while ( i < c && !isFounded ){
                
                if ( myLocation.indexOf( domainList[i] ) !== -1 ) {
                    // el juego estÃ¡ alojado en un dominio permitido
                    isFounded = true;
                } else {
                    if ( i === c - 1 ) {
                        // estÃ¡ alojado en un dominio no permitido, redirigo a otra pÃ¡gina
                        window.location.assign( "http://www.google.com" );
                    }
                }
                i = i + 1;
            }
            
            const crazysdk = window.CrazyGames.CrazySDK.getInstance(); //Getting the SDK
            crazysdk.init(); //Getting the SDK
            
            // adType: 'midgame' & 'rewarded'
            // adReward: '0' for hints, '1' for undos.
            
            window.crazygames_js.requestAd = function( adType, adReward ){
                
                if ( typeof adReward === "number" ) {
                    window.crazygames_js.adReward = adReward; // '0' for 'hints', '1' for 'undos'.
                }
                window.crazygames_js.adType = adType;
                
                crazysdk.requestAd( adType );
            };
            
            // Installing Event Listeners
            crazysdk.addEventListener('adStarted', function(){
                callbackForPreferences(3,0,0,0,0); // mute sound
            });
            crazysdk.addEventListener('adFinished', function(){
                callbackForPreferences(3,0,0,0,1); // reenable sound, enable ui
                
                if ( window.crazygames_js.adType === "rewarded" ) {
                    
                    if ( window.crazygames_js.adReward === 0 ) { // hints
                        
                        window.crazygames_js.rewardHints();
                    
                    } else { // undos
                        
                        window.crazygames_js.rewardUndos();
                    }
                }
            });
            crazysdk.addEventListener('adError', function(){ // reenable sound, enable ui
                if ( window.crazygames_js.adType === "rewarded" ) {
                    window.crazygames_js.adError();
                }
            });
            
            
            var strPreferences = window.crazygames_js.getData( "preferences" ) || 1;
            
            if ( strPreferences == 1 ) { // Es la primera vez HTML5
                
                console.log("First Time JS");
                
                var stringObjPreferences = callbackForPreferences( 1 );
                
                var preferencesJson = JSON.parse( stringObjPreferences );
                
                console.log("salvando preferencias iniciales = " + stringObjPreferences );
                
                window.crazygames_js.saveData( "preferences", stringObjPreferences );
                
                // Niveles desbloqueados inicialmente para cada paquete
                window.crazygames_js.saveData( "1-unlock", 1 );
                window.crazygames_js.saveData( "2-unlock", 1 );
                window.crazygames_js.saveData( "3-unlock", 1 );
                
                // 'loadingScene1' function in lua
                callbackForPreferences( 2 );
                
                //LuaReleaseFunction( callbackForPreferences );
                
            } else { // is more than once HTML5
                
                console.log("Not first time JS");
                console.log( "preferences = "+ strPreferences );
                
                // Get the 'lastGame' value for each pack.
                var v1 = window.crazygames_js.getData( "1-unlock" );
                var v2 = window.crazygames_js.getData( "2-unlock" );
                var v3 = window.crazygames_js.getData( "3-unlock" );
                
                console.log( "lastGame1 = "+ v1 );
                console.log( "lastGame2 = "+ v2 );
                console.log( "lastGame3 = "+ v3 );
                
                callbackForPreferences( strPreferences, v1, v2, v3 );
                
                //LuaReleaseFunction( callbackForPreferences );
            }
            
            window.addEventListener("keydown", function(e) {
                // arrow keys: 37, 38, 39, 40 Arrow keys, space bar: 32
                // keyCode is deprecated
                if ( [37, 38, 39, 40].indexOf(e.key) > -1 || [37, 38, 39, 40].indexOf(e.keyCode) > -1 ) {
                    e.preventDefault();
                }
            }, false);
            /*
            var canvas = document.getElementsByTagName("canvas")[0]
            canvas.style.cursor = "none";
            
            canvas.addEventListener('mouseenter', e => {
                canvas.style.cursor = "none";
                canvas.focus(); // Give focus to canvas
            });
            canvas.addEventListener('mouseover', e => {
                canvas.style.cursor = "none";
                canvas.focus(); // Give focus to canvas
            });
            */
        };
        script.onreadystatechange = onReadyFunction;
        script.onload = onReadyFunction;
        
        head.appendChild(script);
    },
    
    submitStat: function()
    {
    
    },
    
    saveData: function( key, content, callback )
    {
        if (typeof Storage !== "undefined") {
            //  Always stored as strings.
            localStorage.setItem( window.crazygames_js.getUserID() + key, content );
            
            console.log("SAVE DATA: " + window.crazygames_js.getUserID() + key + " = " + content);
        }
    },
    
    getData: function( key )
    {
        if (typeof Storage !== "undefined") {
            var result = localStorage.getItem( window.crazygames_js.getUserID() + key );
            
            console.log( "EJECUTANDO getData" );
            
            //if ( typeof result === "string" ) {
                
            console.log("GET DATA: " + window.crazygames_js.getUserID() + key + " = " + result );
            return result;
            //}
        }
    },
    removeItem: function( key ){
        if (typeof Storage !== "undefined") {
            localStorage.removeItem( key );
        }
    },
    
    // Obtiene el dominio del sitio en elque se ejecuta:
    // document.domain.substring(0, document.domain.indexOf("."));
    getUserID: function() // prefijo usado: ''
    {
        var domainName = document.domain.substring(0, document.domain.indexOf("."));
        return domainName + 'AlecGames' + 'ARROW4'; // '' : prefijo
    }
    
    
};

